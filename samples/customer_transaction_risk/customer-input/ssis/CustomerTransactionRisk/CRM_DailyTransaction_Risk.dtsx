              <properties>
                <property dataType="System.Int32" name="CommandTimeout">0</property>
                <property dataType="System.String" name="OpenRowset" />
                <property dataType="System.String" name="OpenRowsetVariable" />
                <property dataType="System.String" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor" name="SqlCommand">SELECT t.TransactionId, t.AccountId, a.CustomerId, CAST(t.BusinessDate AS date) AS BusinessDate,
       t.Amount, t.CurrencyCode, t.OriginCountryCode, t.TransactionType,
       c.CustomerRiskScore, c.RequiresManualReview
FROM src.CustomerTransaction t
JOIN src.Account a ON a.AccountId = t.AccountId
JOIN src.Customer c ON c.CustomerId = a.CustomerId
WHERE t.BusinessDate = ? AND t.Status = 'POSTED';</property>
